#include <windows.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "GhostManga.manifest"
101 ICON "GhostManga.ico"
201 RCDATA "mirrors\\mirrors.bundle.js"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041f04b0"
        BEGIN
            VALUE "CompanyName",      "SkySoftwareStudios / SkySoft"
            VALUE "FileDescription",  "GhostManga - Native C++20 Desktop Manga Reader"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "GhostManga"
            VALUE "OriginalFilename", "GhostManga.exe"
            VALUE "ProductName",      "GhostManga"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x41f, 1200
    END
END
